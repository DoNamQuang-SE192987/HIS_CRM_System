# Copy to .env and fill in real values:  cp .env.example .env

# --- Database ---
DB_NAME=his_crm
DB_USERNAME=postgres
DB_PASSWORD=change_me_strong_password

# --- Public URLs (replace with your server IP / domain) ---
# Address the BROWSER uses to reach the backend (baked into the frontend at build time)
NEXT_PUBLIC_API_BASE_URL=http://your-server-ip:8080
# Frontend origin allowed by backend CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://your-server-ip:3000

# --- Ports exposed on the host ---
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- App ---
SEED_ENABLED=true
